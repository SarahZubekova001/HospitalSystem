@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Nav

<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(Hospital.Web.Client.Routes).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(Layout.MainLayout)">
                <Authorizing>
                    <div class="container py-4">Načítavam...</div>
                </Authorizing>

                <NotAuthorized Context="authState">
                    @if (!(authState.User.Identity?.IsAuthenticated ?? false))
                    {
                        @MarkRedirect()
                    }
                </NotAuthorized>
            </AuthorizeRouteView>
        </Found>

        <NotFound>
            <LayoutView Layout="@typeof(Layout.MainLayout)">
                <p>Stránka neexistuje.</p>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>

@code {
    private bool _redirecting;
    private bool _shouldRedirect;
    private string _redirectUrl = "/login";

    private RenderFragment MarkRedirect() => builder =>
    {
        if (_redirecting) return;

        var path = "/" + Nav.ToBaseRelativePath(Nav.Uri);
        if (path.StartsWith("/login") || path.StartsWith("/register"))
            return;

        _shouldRedirect = true;
        _redirectUrl = "/login?returnUrl=/" + Uri.EscapeDataString(Nav.ToBaseRelativePath(Nav.Uri));
    };

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (_shouldRedirect && !_redirecting)
        {
            _redirecting = true;
            Nav.NavigateTo(_redirectUrl, true);
        }

        return Task.CompletedTask;
    }
}

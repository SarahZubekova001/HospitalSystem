@using Hospital.Web.Client.Auth
@using Microsoft.AspNetCore.Components.Authorization
@inject HttpClient Http
@inject NavigationManager Nav
@inject ApiAuthStateProvider AuthState

<nav class="navbar navbar-dark navbar-expand-lg app-navbar">
    <div class="container-fluid">
        <NavLink class="navbar-brand" href="" Match="NavLinkMatch.All">Nemocničný systém</NavLink>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#topNav"
                aria-controls="topNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="topNav">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                <AuthorizeView>
                    <Authorized>
                        <li class="nav-item">
                            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">Home</NavLink>
                        </li>
                    </Authorized>
                </AuthorizeView>
            </ul>

            <div class="d-flex align-items-center gap-3">
                <AuthorizeView>
                    <Authorized Context="ctx">
                        <span class="navbar-text text-white">
                            @(ctx.User.FindFirst("fullName")?.Value ?? ctx.User.Identity?.Name)
                        </span>
                        <button class="btn btn-sm btn-outline-light" @onclick="Logout">Logout</button>
                    </Authorized>

                    <NotAuthorized>
                        <NavLink class="btn btn-sm btn-outline-light" href="login">Login</NavLink>
                        <NavLink class="btn btn-sm btn-light" href="register">Register</NavLink>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>
    </div>
</nav>

@code {
    private async Task Logout()
    {
        await Http.PostAsync("/api/auth/logout", null);
        AuthState.Refresh();
        Nav.NavigateTo("/login", true);
    }
}

@implements IDisposable
@using System.Security.Claims
@using Hospital.Web.Client.Auth
@using Microsoft.AspNetCore.Components.Authorization
@inject HttpClient Http
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthProvider
@inject ApiAuthStateProvider ApiAuth

<nav class="topbar">
    <div class="topbar-inner">
        <a class="topbar-brand" href="">Nemocničný systém</a>

        <AuthorizeView Context="rootCtx">
            <Authorized>
                <div class="topbar-links">
                    <AuthorizeView Roles="Admin" Context="adminCtx">
                        <Authorized>
                            <NavLink class="topbar-btn" href="admin/users" Match="NavLinkMatch.Prefix">Účty</NavLink>
                        </Authorized>
                    </AuthorizeView>

                    <AuthorizeView Roles="Pacient" Context="patCtx">
                        <Authorized>
                            <NavLink class="topbar-btn" href="patient" Match="NavLinkMatch.Prefix">Objednávky</NavLink>
                            <NavLink class="topbar-btn" href="patient/records" Match="NavLinkMatch.Prefix">Moje záznamy</NavLink>
                            <NavLink class="topbar-btn" href="patient/prescriptions" Match="NavLinkMatch.Prefix">Moje predpisy</NavLink>

                        </Authorized>
                    </AuthorizeView>

                    <AuthorizeView Roles="Lekár" Context="docCtx">
                        <Authorized>
                            <NavLink class="topbar-btn" href="doctor/patients" Match="NavLinkMatch.Prefix">Moji pacienti</NavLink>
                            <NavLink class="topbar-btn" href="doctor/appointments" Match="NavLinkMatch.Prefix">Objednaní pacienti</NavLink>
                            <NavLink class="topbar-btn" href="doctor/slots" Match="NavLinkMatch.Prefix">Moje sloty</NavLink>
                            <NavLink class="topbar-btn" href="doctor/tlaciva" Match="NavLinkMatch.Prefix">Tlačivá</NavLink>
                        </Authorized>
                    </AuthorizeView>
                </div>

                <div class="topbar-right">
                    @if (MenuOpen)
                    {
                        <div class="user-menu-backdrop" @onclick="CloseMenu"></div>
                    }

                    <div class="user-menu" @onclick:stopPropagation="true">
                        <button type="button" class="topbar-btn user-menu-btn" @onclick="ToggleMenu">
                            @DisplayName
                        </button>

                        @if (MenuOpen)
                        {
                            <div class="user-menu-dropdown">
                                <NavLink class="user-menu-item" href="profile" Match="NavLinkMatch.All" @onclick="CloseMenu">
                                    Môj profil
                                </NavLink>
                                <button type="button" class="user-menu-item danger" @onclick="Logout">Odhlásiť</button>
                            </div>
                        }
                    </div>
                </div>
            </Authorized>

            <NotAuthorized>
                <div class="topbar-links">
                    <NavLink class="topbar-btn" href="login" Match="NavLinkMatch.All">Login</NavLink>
                    <NavLink class="topbar-btn" href="register" Match="NavLinkMatch.All">Register</NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</nav>

@code {
    private string? DisplayName;
    private bool MenuOpen;

    protected override async Task OnInitializedAsync()
    {
        AuthProvider.AuthenticationStateChanged += OnAuthStateChanged;
        await UpdateDisplayName(await AuthProvider.GetAuthenticationStateAsync());
    }

    private void ToggleMenu()
    {
        MenuOpen = !MenuOpen;
    }

    private void CloseMenu()
    {
        MenuOpen = false;
    }

    private async void OnAuthStateChanged(Task<AuthenticationState> task)
    {
        var state = await task;
        await InvokeAsync(async () =>
        {
            await UpdateDisplayName(state);
            MenuOpen = false;
            StateHasChanged();
        });
    }

    private Task UpdateDisplayName(AuthenticationState state)
    {
        var user = state.User;

        if (user.Identity?.IsAuthenticated ?? false)
        {
            DisplayName =
                user.FindFirst("fullName")?.Value
                ?? user.FindFirst(ClaimTypes.Name)?.Value
                ?? user.Identity?.Name;
        }
        else
        {
            DisplayName = null;
        }

        return Task.CompletedTask;
    }

    private async Task Logout()
    {
        MenuOpen = false;
        await Http.PostAsync("/api/auth/logout", null);
        ApiAuth.Refresh();
        Nav.NavigateTo("/login", true);
    }

    public void Dispose()
    {
        AuthProvider.AuthenticationStateChanged -= OnAuthStateChanged;
    }
}

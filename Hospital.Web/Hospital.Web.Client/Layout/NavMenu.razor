@using Hospital.Web.Client.Auth
@using Microsoft.AspNetCore.Components.Authorization
@inject HttpClient Http
@inject NavigationManager Nav
@inject ApiAuthStateProvider AuthState

<nav class="topbar">
    <div class="topbar-inner">
        <a class="topbar-brand" href="">Nemocničný systém</a>

        <AuthorizeView>
            <Authorized>
                <div class="topbar-links">
                    <NavLink class="topbar-btn" href="" Match="NavLinkMatch.All">Home</NavLink>
                    <NavLink class="topbar-btn" href="patient" Match="NavLinkMatch.Prefix">Objednávky</NavLink>
                </div>
            </Authorized>

            <NotAuthorized>
                <div class="topbar-links">
                    <NavLink class="topbar-btn" href="login" Match="NavLinkMatch.All">Login</NavLink>
                    <NavLink class="topbar-btn" href="register" Match="NavLinkMatch.All">Register</NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>

        <AuthorizeView>
            <Authorized Context="ctx">
                <div class="topbar-right">
                    <span class="topbar-user">
                        @(ctx.User.FindFirst("fullName")?.Value ?? ctx.User.Identity?.Name)
                    </span>
                    <button type="button" class="topbar-btn" @onclick="Logout">Logout</button>
                </div>
            </Authorized>
        </AuthorizeView>
    </div>
</nav>

@code {
    private async Task Logout()
    {
        await Http.PostAsync("/api/auth/logout", null);
        AuthState.Refresh();
        Nav.NavigateTo("/login", true);
    }
}

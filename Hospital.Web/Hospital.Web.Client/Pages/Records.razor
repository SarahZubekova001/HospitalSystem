@page "/doctor/patients/{PatientId:int}/records"
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Lekár")]
@inject HttpClient Http
@inject NavigationManager Nav

<h3>Záznamy pacienta</h3>

<div class="d-flex gap-2 mb-3">
    <button class="btn btn-outline-secondary" @onclick="Back">← Späť</button>
    <button class="btn btn-primary" @onclick="OpenCreate">+ Nový záznam</button>
</div>

@if (!string.IsNullOrWhiteSpace(Error))
{
    <div class="alert alert-danger">@Error</div>
}

@if (Loading)
{
    <div>Načítavam...</div>
}
else if (Items.Count == 0)
{
    <div>Žiadne záznamy.</div>
}
else
{
    <div class="list-group" style="max-width: 980px;">
        @foreach (var r in Items)
        {
            <div class="list-group-item">
                <div class="d-flex justify-content-between align-items-start gap-3">
                    <div>
                        <div class="fw-semibold">Záznam: @r.recordNumber</div>
                        <div class="text-muted small">
                            Objednávka: @r.appointmentId |
                            @r.appointmentStartTime.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                        </div>

                        @if (!string.IsNullOrWhiteSpace(r.diagnosisCode) || !string.IsNullOrWhiteSpace(r.diagnosisName))
                        {
                            <div class="text-muted small">
                                Diagnóza: @($"{r.diagnosisCode} {r.diagnosisName}".Trim())
                            </div>
                        }
                    </div>

                    <div class="d-flex gap-2">
                        <button class="btn btn-outline-primary btn-sm" @onclick="() => OpenEdit(r)">Upraviť</button>
                        <button class="btn btn-outline-danger btn-sm" @onclick="() => Delete(r.id)">Zmazať</button>
                        <button class="btn btn-outline-success btn-sm" @onclick="() => OpenPrescriptions(r.id)">Predpisy</button>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(r.results))
                {
                    <div class="mt-2" style="white-space: pre-wrap;">@r.results</div>
                }
            </div>
        }
    </div>
}

@if (ShowModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,.35);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@((EditingId == null) ? "Nový záznam" : "Upraviť záznam")</h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>

                <div class="modal-body">
                    @if (EditingId == null)
                    {
                        <div class="mb-2">
                            <label class="form-label">Objednávka</label>
                            <select class="form-select" @bind="EditAppointmentId">
                                <option value="0">-- vyber objednávku --</option>
                                @foreach (var a in EligibleAppointments)
                                {
                                    <option value="@a.id">@a.startTime.ToLocalTime().ToString("dd.MM.yyyy HH:mm") (ID: @a.id)</option>
                                }
                            </select>
                        </div>
                    }

                    <div class="row g-3">
                        <div class="col-md-12">
                            <label class="form-label">Record number</label>
                            <input class="form-control" @bind="EditRecordNumber" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Hľadať diagnózu</label>
                            <input class="form-control" placeholder="napr. J06 alebo chrípka"
                                   @bind="DiagQuery" @bind:event="oninput" />

                            @if (DiagLoading)
                            {
                                <div class="text-muted small mt-2">Hľadám…</div>
                            }
                            else if (!string.IsNullOrWhiteSpace(DiagQuery) && DiagQuery.Trim().Length >= 2 && DiagResults.Count == 0)
                            {
                                <div class="text-muted small mt-2">Nenašli sa žiadne diagnózy.</div>
                            }

                            @if (DiagResults.Count > 0)
                            {
                                <div class="list-group mt-2" style="max-height: 240px; overflow:auto;">
                                    @foreach (var d in DiagResults)
                                    {
                                        <button type="button" class="list-group-item list-group-item-action"
                                                @onclick="() => SelectDiagnosis(d)">
                                            <div class="fw-semibold">@d.code</div>
                                            <div class="text-muted small">@d.name</div>
                                        </button>
                                    }
                                </div>
                            }
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Vybraná diagnóza</label>
                            <div class="input-group">
                                <input class="form-control" value="@SelectedDiagnosisText" disabled />
                                <button class="btn btn-outline-secondary" type="button" @onclick="ClearDiagnosis">Zrušiť</button>
                            </div>
                        </div>

                        <div class="col-md-12">
                            <label class="form-label">Results</label>
                            <textarea class="form-control" rows="8" @bind="EditResults"></textarea>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button class="btn btn-outline-secondary" @onclick="CloseModal">Zrušiť</button>
                    <button class="btn btn-primary" @onclick="Save" disabled="@Saving">Uložiť</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int PatientId { get; set; }

    private bool Loading;
    private bool Saving;
    private string? Error;

    private List<Row> Items = new();

    private bool ShowModal;
    private int? EditingId;

    private int EditAppointmentId;
    private string EditRecordNumber = "";
    private string? EditResults;

    private List<AppointmentRow> EligibleAppointments = new();

    private bool DiagLoading;
    private string _diagQuery = "";
    private string DiagQuery
    {
        get => _diagQuery;
        set
        {
            if (_diagQuery == value) return;
            _diagQuery = value;
            _ = SearchDiagnoses();
        }
    }

    private List<DiagRow> DiagResults = new();
    private int? SelectedDiagnosisId;
    private string SelectedDiagnosisText = "—";

    protected override async Task OnInitializedAsync()
    {
        await Load();
    }

    private async Task Load()
    {
        Loading = true;
        Error = null;

        try
        {
            Items = await Http.GetFromJsonAsync<List<Row>>($"api/doctor/patients/{PatientId}/records") ?? new();
        }
        catch (Exception ex)
        {
            Error = ex.Message;
        }

        Loading = false;
    }

    private async Task LoadEligibleAppointments()
    {
        EligibleAppointments = await Http.GetFromJsonAsync<List<AppointmentRow>>(
            $"api/doctor/patients/{PatientId}/records/eligible-appointments") ?? new();
    }

    private void Back() => Nav.NavigateTo("/doctor/patients");

    private async Task OpenCreate()
    {
        EditingId = null;
        EditAppointmentId = 0;
        EditRecordNumber = "";
        EditResults = null;
        Error = null;

        _diagQuery = "";
        DiagResults.Clear();
        DiagLoading = false;
        SelectedDiagnosisId = null;
        SelectedDiagnosisText = "—";

        await LoadEligibleAppointments();
        ShowModal = true;
    }

    private void OpenEdit(Row r)
    {
        EditingId = r.id;
        EditAppointmentId = r.appointmentId;
        EditRecordNumber = r.recordNumber ?? "";
        EditResults = r.results;
        Error = null;

        _diagQuery = "";
        DiagResults.Clear();
        DiagLoading = false;
        SelectedDiagnosisId = r.diagnosisId;
        SelectedDiagnosisText = BuildDiagnosisText(r.diagnosisCode, r.diagnosisName);

        ShowModal = true;
    }

    private void CloseModal()
    {
        ShowModal = false;
        Error = null;
    }

    private string BuildDiagnosisText(string? code, string? name)
    {
        var t = $"{code} {name}".Trim();
        return string.IsNullOrWhiteSpace(t) ? "—" : t;
    }

    private async Task SearchDiagnoses()
    {
        var q = DiagQuery?.Trim();

        if (!ShowModal)
            return;

        if (string.IsNullOrWhiteSpace(q) || q.Length < 2)
        {
            DiagResults.Clear();
            DiagLoading = false;
            await InvokeAsync(StateHasChanged);
            return;
        }

        try
        {
            DiagLoading = true;
            await InvokeAsync(StateHasChanged);

            DiagResults = await Http.GetFromJsonAsync<List<DiagRow>>(
                $"api/doctor/diagnoses?q={Uri.EscapeDataString(q)}") ?? new();
        }
        catch (Exception ex)
        {
            Error = ex.Message;
            DiagResults.Clear();
        }
        finally
        {
            DiagLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void SelectDiagnosis(DiagRow d)
    {
        SelectedDiagnosisId = d.id;
        SelectedDiagnosisText = BuildDiagnosisText(d.code, d.name);
        DiagResults.Clear();
    }

    private void ClearDiagnosis()
    {
        SelectedDiagnosisId = null;
        SelectedDiagnosisText = "—";
        DiagResults.Clear();
        _diagQuery = "";
    }

    private async Task Save()
    {
        Saving = true;
        Error = null;

        try
        {
            if (EditingId == null)
            {
                if (EditAppointmentId == 0)
                {
                    Error = "Vyber objednávku.";
                    return;
                }

                var resp = await Http.PostAsJsonAsync(
                    $"api/doctor/patients/{PatientId}/records",
                    new
                    {
                        appointmentId = EditAppointmentId,
                        recordNumber = EditRecordNumber,
                        results = EditResults,
                        diagnosisId = SelectedDiagnosisId
                    });

                if (!resp.IsSuccessStatusCode)
                {
                    Error = await resp.Content.ReadAsStringAsync();
                    return;
                }
            }
            else
            {
                var resp = await Http.PutAsJsonAsync(
                    $"api/doctor/patients/{PatientId}/records/{EditingId}",
                    new
                    {
                        recordNumber = EditRecordNumber,
                        results = EditResults,
                        diagnosisId = SelectedDiagnosisId
                    });

                if (!resp.IsSuccessStatusCode)
                {
                    Error = await resp.Content.ReadAsStringAsync();
                    return;
                }
            }

            ShowModal = false;
            await Load();
        }
        finally
        {
            Saving = false;
        }
    }

    private async Task Delete(int id)
    {
        Error = null;

        var resp = await Http.DeleteAsync($"api/doctor/patients/{PatientId}/records/{id}");
        if (!resp.IsSuccessStatusCode)
        {
            Error = await resp.Content.ReadAsStringAsync();
            return;
        }

        await Load();
    }

    private void OpenPrescriptions(int medicalRecordId)
    {
        Nav.NavigateTo($"/doctor/records/{medicalRecordId}/prescriptions");
    }

    private sealed class Row
    {
        public int id { get; set; }
        public int appointmentId { get; set; }
        public string? recordNumber { get; set; }
        public string? results { get; set; }
        public DateTime appointmentStartTime { get; set; }
        public int? diagnosisId { get; set; }
        public string? diagnosisCode { get; set; }
        public string? diagnosisName { get; set; }
    }

    private sealed class AppointmentRow
    {
        public int id { get; set; }
        public DateTime startTime { get; set; }
    }

    private sealed class DiagRow
    {
        public int id { get; set; }
        public string code { get; set; } = "";
        public string name { get; set; } = "";
    }
}

@page "/doctor/slots"
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Lekár")]
@inject HttpClient Http

<h3>Moje sloty</h3>

<div class="d-flex gap-2 align-items-center mb-3">
    <button class="btn btn-outline-secondary" @onclick="PrevDay">◀</button>
    <input class="form-control" style="max-width: 180px;" type="date" value="@SelectedDate" @onchange="OnDateChanged" />
    <button class="btn btn-outline-secondary" @onclick="NextDay">▶</button>
    <button class="btn btn-primary" @onclick="Load">Načítať</button>
</div>

<div class="card mb-3" style="max-width: 520px;">
    <div class="card-body">
        <h5 class="card-title">Pridať slot</h5>

        <div class="d-flex gap-2 align-items-end">
            <div>
                <label class="form-label">Od</label>
                <input class="form-control" type="time" value="@NewStart" @onchange="OnStartChanged" />
            </div>
            <div>
                <label class="form-label">Do</label>
                <input class="form-control" type="time" value="@NewEnd" @onchange="OnEndChanged" />
            </div>
            <button class="btn btn-success" @onclick="Create">Pridať</button>
        </div>

        @if (!string.IsNullOrWhiteSpace(Error))
        {
            <div class="text-danger mt-2">@Error</div>
        }
    </div>
</div>

@if (Loading)
{
    <div>Načítavam...</div>
}
else if (SlotItems.Count == 0)
{
    <div>Žiadne sloty na tento deň.</div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Čas</th>
                <th>Dostupné</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in SlotItems)
            {
                <tr>
                    <td>@s.startTime.ToLocalTime().ToString("HH:mm") - @s.endTime.ToLocalTime().ToString("HH:mm")</td>
                    <td>
                        <input type="checkbox" checked="@s.isAvailable" @onchange="(e) => Toggle(s, e)" />
                    </td>
                    <td class="text-end">
                        <button class="btn btn-outline-danger btn-sm" @onclick="() => Delete(s.id)">Zmazať</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private bool Loading;
    private string? Error;

    private DateTime SelectedDay = DateTime.Today;
    private string SelectedDate = DateTime.Today.ToString("yyyy-MM-dd");

    private List<SlotRow> SlotItems = new();

    private string NewStart = "08:00";
    private string NewEnd = "08:30";

    protected override async Task OnInitializedAsync()
    {
        await Load();
    }

    private Task OnDateChanged(ChangeEventArgs e)
    {
        SelectedDate = e.Value?.ToString() ?? DateTime.Today.ToString("yyyy-MM-dd");
        return Task.CompletedTask;
    }

    private Task OnStartChanged(ChangeEventArgs e)
    {
        NewStart = e.Value?.ToString() ?? "08:00";
        return Task.CompletedTask;
    }

    private Task OnEndChanged(ChangeEventArgs e)
    {
        NewEnd = e.Value?.ToString() ?? "08:30";
        return Task.CompletedTask;
    }

    private async Task Load()
    {
        if (!DateTime.TryParse(SelectedDate, out var dt))
            dt = DateTime.Today;

        SelectedDay = dt.Date;

        Loading = true;
        Error = null;
        try
        {
            SlotItems = await Http.GetFromJsonAsync<List<SlotRow>>($"api/doctor/slots?date={SelectedDay:yyyy-MM-dd}") ?? new();
        }
        finally
        {
            Loading = false;
        }
    }

    private async Task Create()
    {
        Error = null;

        if (!DateTime.TryParse(SelectedDate, out var dt))
            dt = DateTime.Today;

        SelectedDay = dt.Date;

        if (!TimeSpan.TryParse(NewStart, out var st) || !TimeSpan.TryParse(NewEnd, out var et))
        {
            Error = "Zlý formát času.";
            return;
        }

        var startLocal = SelectedDay.Add(st);
        var endLocal = SelectedDay.Add(et);

        var resp = await Http.PostAsJsonAsync("api/doctor/slots", new CreateSlotRequest(startLocal, endLocal));
        if (!resp.IsSuccessStatusCode)
        {
            Error = await resp.Content.ReadAsStringAsync();
            return;
        }

        await Load();
    }

    private async Task Toggle(SlotRow s, ChangeEventArgs e)
    {
        Error = null;
        var val = (bool)(e.Value ?? false);

        var req = new HttpRequestMessage(HttpMethod.Patch, $"api/doctor/slots/{s.id}/availability?isAvailable={val.ToString().ToLower()}");
        var resp = await Http.SendAsync(req);

        if (!resp.IsSuccessStatusCode)
        {
            Error = await resp.Content.ReadAsStringAsync();
            return;
        }

        await Load();
    }

    private async Task Delete(int id)
    {
        Error = null;

        var resp = await Http.DeleteAsync($"api/doctor/slots/{id}");
        if (!resp.IsSuccessStatusCode)
        {
            Error = await resp.Content.ReadAsStringAsync();
            return;
        }

        await Load();
    }

    private async Task PrevDay()
    {
        SelectedDay = SelectedDay.AddDays(-1);
        SelectedDate = SelectedDay.ToString("yyyy-MM-dd");
        await Load();
    }

    private async Task NextDay()
    {
        SelectedDay = SelectedDay.AddDays(1);
        SelectedDate = SelectedDay.ToString("yyyy-MM-dd");
        await Load();
    }

    private sealed class SlotRow
    {
        public int id { get; set; }
        public DateTime startTime { get; set; }
        public DateTime endTime { get; set; }
        public bool isAvailable { get; set; }
    }

    private sealed class CreateSlotRequest
    {
        public CreateSlotRequest(DateTime startTime, DateTime endTime)
        {
            StartTime = startTime;
            EndTime = endTime;
        }

        public DateTime StartTime { get; set; }
        public DateTime EndTime { get; set; }
    }
}

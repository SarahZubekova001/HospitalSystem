@page "/patient/prescriptions"
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Pacient")]
@inject HttpClient Http
@inject NavigationManager Nav

<h3>Moje predpisy</h3>

<div class="d-flex gap-2 mb-3">
    <button class="btn @(ShowActive ? "btn-primary" : "btn-outline-primary")" type="button" @onclick="() => SetTab(true)">
        Aktuálne
    </button>
    <button class="btn @(!ShowActive ? "btn-primary" : "btn-outline-primary")" type="button" @onclick="() => SetTab(false)">
        Staré
    </button>

    <div class="ms-auto" style="max-width: 320px; width: 100%;">
        <input class="form-control" placeholder="Hľadať liek..." @bind="Query" @bind:event="oninput" />
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Error))
{
    <div class="alert alert-danger">@Error</div>
}

@if (Loading)
{
    <div>Načítavam...</div>
}
else if (Filtered.Count == 0)
{
    <div>Žiadne predpisy.</div>
}
else
{
    <div class="list-group" style="max-width: 980px;">
        @foreach (var p in Filtered)
        {
            <div class="list-group-item">
                <div class="d-flex justify-content-between align-items-start gap-3">
                    <div>
                        <div class="fw-semibold">@p.medicationName</div>

                        @if (!string.IsNullOrWhiteSpace(p.activeSubstance))
                        {
                            <div class="text-muted small">@p.activeSubstance</div>
                        }

                        <div class="mt-2">
                            @if (!string.IsNullOrWhiteSpace(p.dosage))
                            {
                                <div><span class="text-muted">Dávkovanie:</span> @p.dosage</div>
                            }

                            @if (p.quantity.HasValue)
                            {
                                <div><span class="text-muted">Množstvo:</span> @p.quantity</div>
                            }

                            <div>
                                <span class="text-muted">Platnosť do:</span>
                                @(p.validUntil.HasValue? p.validUntil.Value.ToString("dd.MM.yyyy") : "—")
                            </div>
                        </div>

                        <div class="text-muted small mt-2">
                            Záznam: @p.recordNumber | Objednávka: @p.appointmentId | @p.appointmentStartTime.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button class="btn btn-outline-secondary btn-sm" type="button" @onclick="() => OpenRecord(p.medicalRecordId)">
                            Záznam
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private bool Loading;
    private string? Error;

    private bool ShowActive = true;
    private string Query = "";

    private List<Row> Items = new();

    private List<Row> Filtered
        => Items
            .Where(x => x.isActive == ShowActive)
            .Where(x =>
            {
                var q = (Query ?? "").Trim();
                if (string.IsNullOrWhiteSpace(q)) return true;
                q = q.ToLowerInvariant();
                return (x.medicationName ?? "").ToLowerInvariant().Contains(q)
                    || (x.activeSubstance ?? "").ToLowerInvariant().Contains(q)
                    || (x.recordNumber ?? "").ToLowerInvariant().Contains(q);
            })
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        await Load();
    }

    private async Task Load()
    {
        Loading = true;
        Error = null;

        try
        {
            Items = await Http.GetFromJsonAsync<List<Row>>("api/patient/prescriptions") ?? new();
        }
        catch (Exception ex)
        {
            Error = ex.Message;
        }

        Loading = false;
    }

    private void SetTab(bool active)
    {
        ShowActive = active;
    }

    private void OpenRecord(int medicalRecordId)
    {
        Nav.NavigateTo($"/patient/records/{medicalRecordId}/prescriptions");
    }

    private sealed class Row
    {
        public int id { get; set; }
        public int medicalRecordId { get; set; }
        public string? recordNumber { get; set; }
        public int appointmentId { get; set; }
        public DateTime appointmentStartTime { get; set; }

        public int medicationId { get; set; }
        public string? medicationName { get; set; }
        public string? activeSubstance { get; set; }

        public string? dosage { get; set; }
        public int? quantity { get; set; }
        public DateOnly? validUntil { get; set; }

        public bool isActive { get; set; }
    }
}

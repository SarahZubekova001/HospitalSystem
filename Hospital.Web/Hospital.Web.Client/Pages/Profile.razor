@page "/profile"
@using System.Net.Http.Json
@using System.ComponentModel.DataAnnotations
@using System.Text.RegularExpressions
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Hospital.Web.Client.Auth
@attribute [Authorize]
@inject HttpClient Http
@inject ApiAuthStateProvider AuthState

<h3>Môj profil</h3>

@if (Loading)
{
    <div>Načítavam...</div>
}
else if (!string.IsNullOrWhiteSpace(Error))
{
    <div class="alert alert-danger">@Error</div>
}
else if (Model == null)
{
    <div>Profil sa nenašiel.</div>
}
else
{
    <EditForm Model="Edit" OnValidSubmit="Save">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="card" style="max-width: 980px;">
            <div class="card-body">

                <div class="row g-3 mb-2">
                    <div class="col-md-4">
                        <label class="form-label">Prihlasovací email</label>
                        <InputText class="form-control" @bind-Value="Edit.loginEmail" />
                        <ValidationMessage For="@(() => Edit.loginEmail)" />
                    </div>
                    <div class="col-md-4">
                        <div class="text-muted small">Rola</div>
                        <div class="fw-semibold" style="padding-top: 10px;">@Model.user.role</div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Rodné číslo</label>
                        <InputText class="form-control" @bind-Value="Edit.birthNumber" />
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Meno</label>
                        <InputText class="form-control" @bind-Value="Edit.firstName" />
                        <ValidationMessage For="@(() => Edit.firstName)" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Priezvisko</label>
                        <InputText class="form-control" @bind-Value="Edit.lastName" />
                        <ValidationMessage For="@(() => Edit.lastName)" />
                    </div>

                    <div class="col-12">
                        <label class="form-label">Ulica a číslo</label>
                        <InputText class="form-control" @bind-Value="Edit.streetAddress" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">PSČ</label>
                        <InputText class="form-control" @bind-Value="Edit.cityPostalCode" @onblur="CheckPostal" />
                        @if (!string.IsNullOrWhiteSpace(PostalError))
                        {
                            <div class="text-danger small mt-1">@PostalError</div>
                        }
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Telefón</label>
                        <InputText class="form-control" @bind-Value="Edit.phone" />
                        <ValidationMessage For="@(() => Edit.phone)" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Kontaktný email</label>
                        <InputText class="form-control" @bind-Value="Edit.contactEmail" />
                        <ValidationMessage For="@(() => Edit.contactEmail)" />
                    </div>
                </div>

                @if (Model.user.role == "Pacient" && Model.patient != null)
                {
                    <hr />
                    <h5>Pacient</h5>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="text-muted small">Poisťovňa</div>
                            <div class="fw-semibold">
                                @(string.IsNullOrWhiteSpace(Model.patient.insuranceCompanyName) ? "—" : Model.patient.insuranceCompanyName)
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Primárny lekár</label>
                            <InputSelect class="form-select" TValue="int?" @bind-Value="Edit.primaryDoctorId">
                                <option value="">—</option>
                                @foreach (var d in Model.doctors)
                                {
                                    <option value="@d.id">@d.fullName</option>
                                }
                            </InputSelect>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Krvná skupina</label>
                            <InputText class="form-control" @bind-Value="Edit.bloodType" />
                        </div>
                    </div>
                }

                @if (Model.user.role == "Lekár" && Model.staff != null)
                {
                    <hr />
                    <h5>Lekár</h5>

                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label">Špecializácia</label>
                            <InputSelect class="form-select" TValue="int?" @bind-Value="Edit.specializationId">
                                <option value="">—</option>
                                @foreach (var sp in Model.specializations)
                                {
                                    <option value="@sp.id">@sp.name</option>
                                }
                            </InputSelect>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Licenčné číslo</label>
                            <InputText class="form-control" @bind-Value="Edit.licenseNumber" />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Pracovný telefón</label>
                            <InputText class="form-control" @bind-Value="Edit.workPhone" />
                            <ValidationMessage For="@(() => Edit.workPhone)" />
                        </div>
                    </div>
                }

                <div class="d-flex gap-2 mt-4">
                    <button class="btn btn-primary" type="submit" disabled="@Saving">Uložiť</button>
                    <button class="btn btn-outline-secondary" type="button" @onclick="Reset" disabled="@Saving">Vrátiť zmeny</button>

                    @if (!string.IsNullOrWhiteSpace(Success))
                    {
                        <span class="text-success align-self-center">@Success</span>
                    }
                </div>

                <hr />
                <h5>Zmena hesla</h5>

                <div class="row g-3" style="max-width: 420px;">
                    <div class="col-12">
                        <label class="form-label">Aktuálne heslo</label>
                        <input type="password" class="form-control" @bind="CurrentPassword" />
                    </div>

                    <div class="col-12">
                        <label class="form-label">Nové heslo</label>
                        <input type="password" class="form-control" @bind="NewPassword" />
                    </div>

                    <div class="col-12">
                        <label class="form-label">Nové heslo (znovu)</label>
                        <input type="password" class="form-control" @bind="NewPassword2" />
                    </div>

                    <div class="col-12">
                        <button class="btn btn-outline-primary" type="button" @onclick="ChangePassword" disabled="@Saving">
                            Zmeniť heslo
                        </button>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(PasswordError))
                    {
                        <div class="text-danger">@PasswordError</div>
                    }

                    @if (!string.IsNullOrWhiteSpace(PasswordSuccess))
                    {
                        <div class="text-success">@PasswordSuccess</div>
                    }
                </div>

            </div>
        </div>
    </EditForm>
}

@code {
    private bool Loading;
    private bool Saving;
    private string? Error;
    private string? Success;
    private string? PostalError;

    private ProfileResponse? Model;
    private EditModel Edit = new();

    private string? CurrentPassword;
    private string? NewPassword;
    private string? NewPassword2;
    private string? PasswordError;
    private string? PasswordSuccess;

    protected override async Task OnInitializedAsync()
    {
        await Load();
    }

    private static string? Norm(string? s)
        => string.IsNullOrWhiteSpace(s) ? null : s.Trim();

    private static bool Same(string? a, string? b)
        => string.Equals(Norm(a), Norm(b), StringComparison.Ordinal);

    private sealed class PostalExistsResponse
    {
        public bool exists { get; set; }
    }

    private async Task CheckPostal(FocusEventArgs _)
    {
        PostalError = null;

        var psc = Norm(Edit.cityPostalCode);
        if (string.IsNullOrWhiteSpace(psc)) return;

        if (!Regex.IsMatch(psc, @"^\d{5}$"))
        {
            PostalError = "PSČ musí mať presne 5 číslic.";
            return;
        }

        var res = await Http.GetFromJsonAsync<PostalExistsResponse>($"api/profile/postal-exists?psc={Uri.EscapeDataString(psc)}");
        if (res == null || !res.exists)
            PostalError = "Zadané PSČ neexistuje v tabuľke City.";
    }

    private async Task Load()
    {
        Loading = true;
        Error = null;
        Success = null;
        PostalError = null;

        try
        {
            Model = await Http.GetFromJsonAsync<ProfileResponse>("api/profile");
            if (Model != null)
            {
                Edit = new EditModel
                {
                    loginEmail = Model.user.loginEmail,
                    birthNumber = Model.user.birthNumber,
                    firstName = Model.user.firstName,
                    lastName = Model.user.lastName,
                    streetAddress = Model.user.streetAddress,
                    cityPostalCode = Model.user.cityPostalCode,
                    phone = Model.user.phone,
                    contactEmail = Model.user.contactEmail,
                    bloodType = Model.patient?.bloodType,
                    primaryDoctorId = Model.patient?.primaryDoctorId,
                    workPhone = Model.staff?.workPhone,
                    licenseNumber = Model.staff?.licenseNumber,
                    specializationId = Model.staff?.specializationId
                };
            }
        }
        catch (Exception ex)
        {
            Error = ex.Message;
        }
        finally
        {
            Loading = false;
        }
    }

    private async Task Save()
    {
        if (Model == null) return;

        await CheckPostal(default);
        if (!string.IsNullOrWhiteSpace(PostalError))
        {
            Error = PostalError;
            return;
        }

        Saving = true;
        Error = null;
        Success = null;

        var req = new UpdateProfileRequest(
            Norm(Edit.loginEmail),
            Same(Edit.birthNumber, Model.user.birthNumber) ? null : Norm(Edit.birthNumber),
            Same(Edit.firstName, Model.user.firstName) ? null : Norm(Edit.firstName),
            Same(Edit.lastName, Model.user.lastName) ? null : Norm(Edit.lastName),
            Same(Edit.streetAddress, Model.user.streetAddress) ? null : Norm(Edit.streetAddress),
            Same(Edit.cityPostalCode, Model.user.cityPostalCode) ? null : Norm(Edit.cityPostalCode),
            Same(Edit.phone, Model.user.phone) ? null : Norm(Edit.phone),
            Same(Edit.contactEmail, Model.user.contactEmail) ? null : Norm(Edit.contactEmail),
            Same(Edit.bloodType, Model.patient?.bloodType) ? null : Norm(Edit.bloodType),
            Edit.primaryDoctorId == Model.patient?.primaryDoctorId ? null : Edit.primaryDoctorId,
            Same(Edit.workPhone, Model.staff?.workPhone) ? null : Norm(Edit.workPhone),
            Same(Edit.licenseNumber, Model.staff?.licenseNumber) ? null : Norm(Edit.licenseNumber),
            Edit.specializationId == Model.staff?.specializationId ? null : Edit.specializationId
        );

        var resp = await Http.PutAsJsonAsync("api/profile", req);

        if (!resp.IsSuccessStatusCode)
        {
            Error = await resp.Content.ReadAsStringAsync();
            Saving = false;
            return;
        }

        Success = "Uložené";
        await Load();
        AuthState.Refresh();
        Saving = false;
    }

    private async Task ChangePassword()
    {
        PasswordError = null;
        PasswordSuccess = null;

        if (string.IsNullOrWhiteSpace(CurrentPassword) ||
            string.IsNullOrWhiteSpace(NewPassword))
        {
            PasswordError = "Vyplň všetky polia.";
            return;
        }

        if (NewPassword != NewPassword2)
        {
            PasswordError = "Nové heslá sa nezhodujú.";
            return;
        }

        var resp = await Http.PostAsJsonAsync("api/auth/change-password", new
        {
            currentPassword = CurrentPassword,
            newPassword = NewPassword
        });

        if (!resp.IsSuccessStatusCode)
        {
            PasswordError = await resp.Content.ReadAsStringAsync();
            return;
        }

        PasswordSuccess = "Heslo bolo úspešne zmenené.";
        CurrentPassword = NewPassword = NewPassword2 = null;
    }

    private void Reset()
    {
        if (Model == null) return;

        Error = null;
        Success = null;
        PostalError = null;

        Edit = new EditModel
        {
            loginEmail = Model.user.loginEmail,
            birthNumber = Model.user.birthNumber,
            firstName = Model.user.firstName,
            lastName = Model.user.lastName,
            streetAddress = Model.user.streetAddress,
            cityPostalCode = Model.user.cityPostalCode,
            phone = Model.user.phone,
            contactEmail = Model.user.contactEmail,
            bloodType = Model.patient?.bloodType,
            primaryDoctorId = Model.patient?.primaryDoctorId,
            workPhone = Model.staff?.workPhone,
            licenseNumber = Model.staff?.licenseNumber,
            specializationId = Model.staff?.specializationId
        };
    }

    private sealed record UpdateProfileRequest(
        string? LoginEmail,
        string? BirthNumber,
        string? FirstName,
        string? LastName,
        string? StreetAddress,
        string? CityPostalCode,
        string? Phone,
        string? ContactEmail,
        string? BloodType,
        int? PrimaryDoctorId,
        string? WorkPhone,
        string? LicenseNumber,
        int? SpecializationId
    );

    private sealed class ProfileResponse
    {
        public UserDto user { get; set; } = new();
        public PatientDto? patient { get; set; }
        public StaffDto? staff { get; set; }
        public List<DoctorDto> doctors { get; set; } = new();
        public List<SpecializationDto> specializations { get; set; } = new();
    }

    private sealed class UserDto
    {
        public string loginEmail { get; set; } = "";
        public string role { get; set; } = "";
        public string birthNumber { get; set; } = "";
        public string firstName { get; set; } = "";
        public string lastName { get; set; } = "";
        public string? streetAddress { get; set; }
        public string? cityPostalCode { get; set; }
        public string? phone { get; set; }
        public string? contactEmail { get; set; }
    }

    private sealed class PatientDto
    {
        public string? bloodType { get; set; }
        public int? primaryDoctorId { get; set; }
        public string? insuranceCompanyName { get; set; }
    }

    private sealed class StaffDto
    {
        public int? specializationId { get; set; }
        public string? licenseNumber { get; set; }
        public string? workPhone { get; set; }
    }

    private sealed class DoctorDto
    {
        public int id { get; set; }
        public string fullName { get; set; } = "";
    }

    private sealed class SpecializationDto
    {
        public int id { get; set; }
        public string name { get; set; } = "";
    }

    private sealed class EditModel
    {
        [Required(ErrorMessage = "Prihlasovací email je povinný.")]
        [RegularExpression(@".+@.+", ErrorMessage = "Email musí obsahovať znak @.")]
        public string? loginEmail { get; set; }

        public string? birthNumber { get; set; }

        [Required(ErrorMessage = "Meno je povinné.")]
        public string? firstName { get; set; }

        [Required(ErrorMessage = "Priezvisko je povinné.")]
        public string? lastName { get; set; }

        public string? streetAddress { get; set; }
        public string? cityPostalCode { get; set; }

        [PhoneSk(ErrorMessage = "Telefón nie je v správnom formáte.")]
        public string? phone { get; set; }

        [RegularExpression(@".+@.+", ErrorMessage = "Email musí obsahovať znak @.")]
        public string? contactEmail { get; set; }

        public string? bloodType { get; set; }
        public int? primaryDoctorId { get; set; }

        [PhoneSk(ErrorMessage = "Pracovný telefón nie je v správnom formáte.")]
        public string? workPhone { get; set; }

        public string? licenseNumber { get; set; }
        public int? specializationId { get; set; }
    }

    private sealed class PhoneSkAttribute : ValidationAttribute
    {
        protected override ValidationResult? IsValid(object? value, ValidationContext validationContext)
        {
            var s = value as string;
            if (string.IsNullOrWhiteSpace(s))
                return ValidationResult.Success;

            s = s.Trim();
            if (!Regex.IsMatch(s, @"^\+?[0-9 \-]+$"))
                return new ValidationResult(ErrorMessage);

            return ValidationResult.Success;
        }
    }
}

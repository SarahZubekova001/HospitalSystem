@page "/login"
@using Hospital.Web.Client.Auth
@using Microsoft.AspNetCore.Components
@using System.Web
@inject HttpClient Http
@inject NavigationManager Nav
@inject ApiAuthStateProvider AuthState


<h3>Prihlásenie</h3>

<div style="max-width:420px">
    <div>
        <label>Email</label><br />
        <input @bind="email" />
    </div>

    <div style="margin-top:8px">
        <label>Heslo</label><br />
        <input type="password" @bind="password" />
    </div>

    <div style="margin-top:12px">
        <button @onclick="DoLogin">Prihlásiť</button>
    </div>

    @if (!string.IsNullOrWhiteSpace(error))
    {
        <p style="color:red">@error</p>
    }
</div>

@code {
    private string email = "";
    private string password = "";
    private string? error;

    private string returnUrl = "/";

    protected override void OnInitialized()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var query = HttpUtility.ParseQueryString(uri.Query);
        var url = query["returnUrl"];
        if (!string.IsNullOrWhiteSpace(url))
        {
            returnUrl = url!;
        }
    }

    private async Task DoLogin()
    {
        error = null;

        var resp = await Http.PostAsJsonAsync("/api/auth/login",
            new { Email = email, Password = password });

        if (resp.IsSuccessStatusCode)
        {
            AuthState.Refresh();

            Nav.NavigateTo(returnUrl, forceLoad: true);
            return;
        }

        error = await resp.Content.ReadAsStringAsync();
        if (string.IsNullOrWhiteSpace(error))
            error = "Prihlásenie zlyhalo.";
    }
}

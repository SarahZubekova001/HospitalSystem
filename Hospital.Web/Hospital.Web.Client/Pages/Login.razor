@page "/login"
@using System.Net.Http.Json
@using System.Web
@using Microsoft.AspNetCore.Components.Authorization
@using Hospital.Web.Client.Auth
@inject HttpClient Http
@inject NavigationManager Nav
@inject ApiAuthStateProvider AuthState
@inject AuthenticationStateProvider AspAuth

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-sm-10 col-md-8 col-lg-6 col-xl-5">
            <div class="card shadow-sm">
                <div class="card-body p-4">
        
                <h2 class="mb-4">Prihlásenie</h2>

                <div class="mb-3">
                    <label class="form-label">Email</label>
                    <input class="form-control" @bind="email" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Heslo</label>
                    <input class="form-control" type="password" @bind="password" />
                </div>

                <button class="btn btn-primary w-100" @onclick="DoLogin">Prihlásiť</button>

                @if (!string.IsNullOrWhiteSpace(error))
                {
                    <div class="text-danger mt-3">@error</div>
                }

                <div class="text-center mt-3">
                    Nemáte účet?
                    <a href="/register">Registrujte sa</a>
                </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string email = "";
    private string password = "";
    private string? error;
    private string returnUrl = "/";

    protected override async Task OnInitializedAsync()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var query = HttpUtility.ParseQueryString(uri.Query);
        var url = query["returnUrl"];
        if (!string.IsNullOrWhiteSpace(url))
            returnUrl = url!;

        var state = await AspAuth.GetAuthenticationStateAsync();
        if (state.User.Identity?.IsAuthenticated ?? false)
        {
            Nav.NavigateTo(returnUrl, true);
        }
    }

    private async Task DoLogin()
    {
        error = null;

        var resp = await Http.PostAsJsonAsync("/api/auth/login",
            new { Email = email, Password = password });

        if (resp.IsSuccessStatusCode)
        {
            AuthState.Refresh();
            Nav.NavigateTo(returnUrl, true);
            return;
        }

        error = await resp.Content.ReadAsStringAsync();
        if (string.IsNullOrWhiteSpace(error))
            error = "Prihlásenie zlyhalo.";
    }
}

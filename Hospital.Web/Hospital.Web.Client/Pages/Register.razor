@page "/register"
@inject HttpClient Http
@inject NavigationManager Nav

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-sm-10 col-md-8 col-lg-6 col-xl-5">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <h3 class="mb-4">Registrácia pacienta</h3>

                    <div class="mb-3">
                        <label class="form-label">Rodné číslo</label>
                        <input class="form-control" @bind="BirthNumber" autocomplete="off" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Meno</label>
                        <input class="form-control" @bind="FirstName" autocomplete="given-name" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Priezvisko</label>
                        <input class="form-control" @bind="LastName" autocomplete="family-name" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <input class="form-control" type="email" @bind="Email" autocomplete="email" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Heslo</label>
                        <input class="form-control" type="password" @bind="Password" autocomplete="new-password" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">ID poisťovne</label>
                        <input class="form-control" type="number" @bind="InsuranceCompanyId" />
                    </div>

                    @if (!string.IsNullOrWhiteSpace(error))
                    {
                        <div class="alert alert-danger py-2 mb-3">@error</div>
                    }

                    <button class="btn btn-primary w-100" @onclick="DoRegister">Registrovať</button>

                    <div class="text-center mt-3">
                        <span>Máte už účet? </span>
                        <NavLink href="login">Prihláste sa</NavLink>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string BirthNumber = "";
    private string FirstName = "";
    private string LastName = "";
    private string Email = "";
    private string Password = "";
    private int InsuranceCompanyId;
    private string? error;

    private async Task DoRegister()
    {
        error = null;

        var payload = new
        {
            BirthNumber,
            FirstName,
            LastName,
            Email,
            Password,
            InsuranceCompanyId,
            StreetAddress = (string?)null,
            CityPostalCode = (string?)null,
            Phone = (string?)null
        };

        var resp = await Http.PostAsJsonAsync("/api/auth/register", payload);

        if (resp.IsSuccessStatusCode)
        {
            Nav.NavigateTo("/login", forceLoad: true);
            return;
        }

        var msg = await resp.Content.ReadAsStringAsync();
        error = string.IsNullOrWhiteSpace(msg) ? "Registrácia zlyhala." : msg;
    }
}

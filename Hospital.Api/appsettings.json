{
  
    "ReverseProxy": {
      "Routes": {
        "apiRoute": {
          "ClusterId": "apiCluster",
          "Match": { "Path": "/api/{**catch-all}" }
        }
      },
      "Clusters": {
        "apiCluster": {
          "Destinations": {
            "d1": { "Address": "https://localhost:7183/" }
          }
        }
      }
    }
  ,
  "ConnectionStrings": {
